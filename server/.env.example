# Conexión al PostgreSQL de Docker (docker compose up -d)
DATABASE_URL=postgres://michi:michi_casino_2026@localhost:5440/michi_casino

PORT=4000

# Cadena larga y secreta para firmar las sesiones
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# Cuenta de administrador (se crea al iniciar el servidor si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Zona horaria para el bono diario
TIMEZONE=America/Bogota

# Pon false cuando ella ya se haya registrado para cerrar el registro
ALLOW_REGISTRATION=true

# true si la base exige SSL (URL externa de Render)
DATABASE_SSL=false
# En producción con HTTPS (Render) pon ambos en true
COOKIE_SECURE=false
TRUST_PROXY=false
