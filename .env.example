# ================= Michi Casino · configuración =================
# Copia este archivo como .env y cambia los valores marcados.

# --- Base de datos (Docker local) ---
DB_USER=michi
DB_PASSWORD=cambia-esta-contraseña-de-base-de-datos
DB_NAME=michi_casino
DB_PORT=5440
# true solo si te conectas a una base externa que exige SSL (p. ej. la URL externa de Render)
DATABASE_SSL=false

# --- App ---
PORT=4000
APP_PORT=8080
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pon-aqui-una-cadena-larga-y-secreta
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña
TIMEZONE=America/Bogota
# Pon false cuando ella ya tenga cuenta para cerrar el registro
ALLOW_REGISTRATION=true

# --- Producción detrás de HTTPS (Render): ambos en true ---
COOKIE_SECURE=false
TRUST_PROXY=false

# --- Recuperación de contraseña (pregunta secreta) ---
RECOVERY_QUESTION=¿Cómo se llama mi jugador de fútbol favorito?
RECOVERY_OPTIONS=Opción 1,Opción 2,Opción 3,Opción 4
# Debe ser una de las opciones. Déjala vacía para desactivar la recuperación.
RECOVERY_ANSWER=
# Pon true y reinicia para que la contraseña del admin vuelva a ser ADMIN_PASSWORD (luego vuelve a false)
ADMIN_RESET_PASSWORD=false
